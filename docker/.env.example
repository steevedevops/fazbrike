# Fazbrike — variáveis de produção (copiar para docker/.env e preencher)
# docker/.env NÃO é versionado (.gitignore).

# Obrigatórios
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 24  (senha do Postgres do container `database`)
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_PASSWORD=

# Emails promovidos a admin no boot (separados por vírgula)
ADMIN_EMAILS=

# CORS (default: fazbrike.com.br, www e admin)
#ALLOWED_ORIGINS=https://fazbrike.com.br,https://www.fazbrike.com.br,https://admin.fazbrike.com.br

# URLs embutidas no build do site/admin (mudar exige rebuild)
#NEXT_PUBLIC_API_URL=https://api.fazbrike.com.br/api
#NEXT_PUBLIC_SITE_URL=https://fazbrike.com.br
#PUBLIC_API_URL=https://api.fazbrike.com.br/api

# Opcionais — também podem ser definidos em Configurações no admin (DB → env → default)
#UPLOAD_MAX_MB=10
#MAILGUN_API_KEY=
#MAILGUN_DOMAIN=
#B2_ENABLED=false

# Push (FCM) — JSON da service account do projeto Firebase `fazbrike`.
# Preferível colar em Configurações > FIREBASE_CREDENTIALS no admin; ou montar
# o arquivo no container e apontar o caminho:
#FIREBASE_CREDENTIALS_PATH=/opt/fazbrike/backend/secrets/firebase-adminsdk.json
# Login Google/Apple: projeto cujos ID tokens são aceitos (default: fazbrike)
#FIREBASE_PROJECT_ID=fazbrike
