# Fazbrike - Nginx para deploy do backend (API Go)
# Copiar para /etc/nginx/sites-available/api.fazbrike.com.br e ativar com link em sites-enabled
# Container: docker compose service `backend` em 127.0.0.1:8010
# Path do volume de uploads no servidor: /home/steeve/apps/fazbrike/docker/uploads

server {
    # Nginx < 1.25: usar "listen 443 ssl http2;" (não a diretiva "http2 on;")
    listen                    80;
    listen                    [::]:80;
    #listen 443 ssl http2;
    #listen [::]:443 ssl http2;
    server_name               api.fazbrike.com.br;

    # Restore de backup no admin aceita até BACKUP_MAX_MB (default 500)
    client_max_body_size      512M;
    gzip                      on;
    gzip_types                text/plain application/xml text/css application/javascript application/json;

    #ssl_certificate           /etc/letsencrypt/live/api.fazbrike.com.br/fullchain.pem;
    #ssl_certificate_key       /etc/letsencrypt/live/api.fazbrike.com.br/privkey.pem;
    #ssl_protocols             TLSv1.2 TLSv1.3;
    #ssl_ciphers               EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH:ECDHE-RSA-AES128-SHA;
    #ssl_prefer_server_ciphers on;

    proxy_read_timeout        300;
    proxy_connect_timeout     300;
    proxy_send_timeout        300;

    # Uploads locais (imagens) — servidos direto do volume do docker.
    # Com B2_ENABLED=true as imagens vêm do bucket e esta regra fica ociosa.
    location /api/uploads/ {
        alias /home/steeve/apps/fazbrike/docker/uploads/;
        expires 1y;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
    }

    # API Go/Gin (porta do docker-compose: 8010)
    location / {
        proxy_pass             http://127.0.0.1:8010;
        proxy_http_version     1.1;
        proxy_set_header       Host $host;
        proxy_set_header       X-Real-IP $remote_addr;
        proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $scheme;
    }
}
