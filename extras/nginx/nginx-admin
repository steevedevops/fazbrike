# Fazbrike — Nginx do painel admin (SvelteKit estático no container)
# Copiar para /etc/nginx/sites-available/admin.fazbrike.com.br e ativar com link em sites-enabled
# Container: docker compose service `admin` em 127.0.0.1:8091

server {
    listen                    80;
    listen                    [::]:80;
    #listen 443 ssl http2;
    #listen [::]:443 ssl http2;
    server_name               admin.fazbrike.com.br;

    gzip                      on;
    gzip_types                text/plain text/css application/javascript application/json image/svg+xml;

    #ssl_certificate           /etc/letsencrypt/live/admin.fazbrike.com.br/fullchain.pem;
    #ssl_certificate_key       /etc/letsencrypt/live/admin.fazbrike.com.br/privkey.pem;
    #ssl_protocols             TLSv1.2 TLSv1.3;
    #ssl_ciphers               EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH:ECDHE-RSA-AES128-SHA;
    #ssl_prefer_server_ciphers on;

    # Painel interno — não indexar
    add_header                X-Robots-Tag "noindex, nofollow" always;
    add_header                X-Frame-Options "DENY" always;

    location / {
        proxy_pass             http://127.0.0.1:8091;
        proxy_http_version     1.1;
        proxy_set_header       Host $host;
        proxy_set_header       X-Real-IP $remote_addr;
        proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $scheme;
    }
}
